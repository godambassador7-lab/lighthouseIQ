!public/data/cms-care-compare-summary.json
!public/data/state-hcai-oshpd-summary.json
!public/data/irs-990-summary.json
!public/data/hospital-annual-reports-summary.json

# Temporary files
*.tmp
*.temp
.tmp_*
nul

