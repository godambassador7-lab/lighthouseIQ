# Dependencies
node_modules/

# Build outputs
dist/

# Environment files (NEVER commit these!)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Test coverage
coverage/

# Keep the data directory but ignore generated files
# (GitHub Actions will generate these)
public/data/*.json
public/data/by-state/*.json
!public/data/.gitkeep
!public/data/by-state/.gitkeep
!public/data/state-beacon.json
!public/data/hospital-rankings.json
!public/data/strikes.json
!public/data/free-market-signals.json
!public/data/market-readiness-integration.json
