{
  "name": "lighthouse-nursing-intelligence",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@lni/core && npm run build --workspace=@lni/adapters",
    "build:scripts": "npx tsc -p scripts/tsconfig.json",
    "fetch:hospital-rankings": "node scripts/fetch-hospital-rankings.js",
    "fetch:hospital-rankings:monthly": "node scripts/fetch-hospital-rankings.js",
    "backfill:hospital-beds": "node scripts/backfill-hospital-beds.js",
    "news:merge": "node scripts/merge-news.js",
    "news:fetch:us": "node scripts/fetch-us-health-news.js",
    "news:filter-state": "node scripts/filter-state-news.js",
    "news:quality": "node scripts/check-news-quality.js",
    "news:quality:strict": "node scripts/check-news-quality.js --strict",
    "build:free-market-signals": "node scripts/build-free-market-signals.js",
    "fetch:market-required-summaries": "node scripts/fetch-market-required-summaries.js",
    "fetch:market-required-metrics": "node scripts/fetch-market-required-metrics.js",
    "build:provider-master": "node scripts/build-provider-master.js",
    "enrich:provider-master:npi": "node scripts/enrich-provider-master-npi.js",
    "build:facility-market-features": "node scripts/build-facility-market-features.js",
    "build:market-readiness-integration": "node scripts/build-market-readiness-integration.js",
    "build:market-data": "npm run build:free-market-signals && npm run fetch:market-required-summaries && npm run fetch:market-required-metrics && npm run build:provider-master && npm run build:facility-market-features && npm run build:market-readiness-integration",
    "build:target-metros": "node scripts/compile-target-state-metros.js",
    "guard:ui": "node scripts/guard-protected-ui.js",
    "export": "npm run build && npm run build:scripts && node dist/scripts/export-notices.js",
    "dev": "npm -ws run dev",
    "api:start": "node apps/api/dist/index.js",
    "live": "node apps/api/dist/index.js",
    "lint": "npm -ws run lint",
    "serve": "npx serve public -l 3000"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/pg": "^8.11.10",
    "serve": "^14.2.1",
    "typescript": "^5.5.4"
  }
}
